#!/bin/bash
# Kosmos invokes ffmpeg itself; keep decoding, encoding and filtering single-threaded.
set -euo pipefail
: "${FFMPEG_BIN:?Set FFMPEG_BIN to the real ffmpeg executable}"
args=("$@")
if ((${#args[@]} == 0)); then
    exec "$FFMPEG_BIN"
fi
last=$((${#args[@]} - 1))
exec "$FFMPEG_BIN" -threads 1 -filter_threads 1 -filter_complex_threads 1 "${args[@]:0:$last}" -threads 1 "${args[$last]}"
